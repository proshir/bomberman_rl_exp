# Code has its own Git repository.
/src/

# Local Python environment and agent tooling.
/env/
/.agents/
/.codex/

# Secrets and local configuration.
.env
.env.*
matador.json

# Python caches and generated logs.
__pycache__/
*.py[cod]
.pytest_cache/
*.log

# Large generated experiment artifacts; keep references in tracked notes.
/experiments/**/checkpoints/
/experiments/**/replays/
experiments/**/training.pkl
/experiments/**/evaluation/**/batches/
/experiments/**/evaluation/**/games/
/experiments/**/batches/
/experiments/**/games/
/experiments/*smoke*/
/experiments/*diagnostics*/
*.pt
*.pth
*.ckpt

# Keep report files out of the public repository.
/report/
/reports/
